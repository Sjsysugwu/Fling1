local function flashScreen(color)
    local flash = Instance.new("Frame")
    flash.Size = UDim2.new(1, 0, 1, 0)
    flash.BackgroundColor3 = color
    flash.BackgroundTransparency = 0.8
    flash.ZIndex = 100
    flash.Parent = ScreenGui

    TweenService:Create(
        flash,
        TweenInfo.new(0.3),
        {BackgroundTransparency = 1}
    ):Play()

    task.delay(0.4, function()
        flash:Destroy()
    end)
end

local function shakeScreen()
    local originalPos = Main.Position

    for i = 1, 8 do
        Main.Position = originalPos + UDim2.new(
            0,
            math.random(-8, 8),
            0,
            math.random(-8, 8)
        )
        task.wait(0.02)
    end

    Main.Position = originalPos
end

local function particleBurst(center)
    for i = 1, 25 do
        local particle = Instance.new("Frame")
        particle.Size = UDim2.new(0, 6, 0, 6)
        particle.Position = center
        particle.BackgroundColor3 = Color3.fromHSV(i / 25, 1, 1)
        particle.ZIndex = 50
        particle.Parent = ScreenGui

        local target = center + UDim2.new(
            0,
            math.random(-250, 250),
            0,
            math.random(-250, 250)
        )

        TweenService:Create(
            particle,
            TweenInfo.new(
                0.8,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                Position = target,
                Rotation = math.random(0, 360),
                BackgroundTransparency = 1
            }
        ):Play()

        task.delay(1, function()
            particle:Destroy()
        end)
    end
end

